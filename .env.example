# Quality Chamados — stack Docker
# Copie para .env e preencha (ou configure na Stack do Portainer). NUNCA commite o .env preenchido.

# ── OBRIGATÓRIAS ───────────────────────────────────────────────
# Segredo de assinatura dos tokens de sessão. Sem valor, a API não sobe em produção.
# Gere com: openssl rand -hex 32
JWT_SECRET=

# Origens aceitas pelo CORS, separadas por vírgula. Use a URL pública do app.
# Exemplo: WEB_ORIGIN=https://chamados.seudominio.com.br
WEB_ORIGIN=

# ── OPCIONAIS ──────────────────────────────────────────────────
# Porta publicada no host (é para ela que o Public Hostname do túnel aponta).
APP_PORT=3021

# Contato exigido pelo Web Push (mailto: ou https:).
# Exemplo: VAPID_SUBJECT=mailto:suporte@seudominio.com.br
VAPID_SUBJECT=
