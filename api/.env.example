# Copie para api/.env para desenvolvimento local. NUNCA commite o .env.

# Banco. Dev = SQLite local.
DATABASE_URL="file:./dev.db"

# Segredo do JWT. Em dev pode ficar vazio (usa um padrão inseguro);
# em produção é obrigatório. Gere com: openssl rand -hex 32
JWT_SECRET=

# CORS: origens do front (separadas por vírgula). Vazio = libera todas (só dev).
WEB_ORIGIN=

# Contato do Web Push (opcional)
VAPID_SUBJECT=

# Marca produção — ativa as travas de segurança.
# NODE_ENV=production

PORT=3002
